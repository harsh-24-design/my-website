# CppMastery Compiler Backend Configuration

# Choose your code execution backend: 'piston' (free, no API key needed) or 'judge0'
COMPILER_BACKEND=piston

# Piston API endpoint (Default public instance)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# Judge0 API Configuration (Optional: RapidAPI or Self-Hosted instance)
# If using RapidAPI Judge0:
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=your_rapidapi_key_here
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Execution Limits
EXECUTION_TIMEOUT_MS=10000
MAX_OUTPUT_SIZE_BYTES=65536
